# Copy this file to backend/.env and load its values into your local IDE run configuration.
# Do not commit backend/.env.
DB_URL=jdbc:mysql://127.0.0.1:3306/second_hand_trade?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=campus_agent
DB_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_UPLOAD_DIR=./uploads
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_SECONDS=25
AI_SERVICE_MAX_CONCURRENT_REQUESTS=8
AI_SERVICE_QUEUE_TIMEOUT_MS=150
AGENT_SERVICE_TOKEN=replace-with-a-random-service-token
AGENT_TRACE_RETENTION_DAYS=90
PAYMENT_RETURN_URL=http://127.0.0.1:5173/orders
ALIPAY_ENABLED=false
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_NOTIFY_URL=
WECHAT_ENABLED=false
WECHAT_GATEWAY=https://api.mch.weixin.qq.com
WECHAT_APP_ID=
WECHAT_MCH_ID=
