# Copy to .env and fill locally. Never commit real secrets.
# Agnes exposes an OpenAI-compatible API used by LangChain Tool Calling.
EXTERNAL_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
EXTERNAL_LLM_MODEL=agnes-2.0-flash
EXTERNAL_LLM_API_KEY=replace_with_your_agnes_api_key
LLM_TIMEOUT_SECONDS=18
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_MS=250
LLM_MAX_CONCURRENT_REQUESTS=4
LLM_QUEUE_TIMEOUT_MS=100
LLM_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=30

# Required for the enterprise Agent tool gateway. Use the same non-empty value
# in backend/.env and ai/.env; do not commit the real value.
BACKEND_BASE_URL=http://127.0.0.1:8080
AGENT_SERVICE_TOKEN=replace-with-a-random-service-token
AGENT_TOOL_TIMEOUT_SECONDS=3
AGENT_MAX_TOOL_CALLS=6
AGENT_RUN_TIMEOUT_SECONDS=50

# Optional phase-two RAG configuration. Start Qdrant before enabling this.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=campus_trade_knowledge
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_FALLBACK=true

# Leave empty to keep tracing local. Set this only to your enterprise OTLP collector.
OTEL_SERVICE_NAME=campus-trade-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set true locally to print redacted Agent Run/tool spans to the AI service console.
OTEL_CONSOLE_EXPORTER=false
